    "data_in[9]" + "rst_n" + "start" + "test_mode"';
    "_po" = '"SCAN_OUT" + "busy" + "done" + "spike_data[0]" + "spike_data[1]" + 
    "spike_data[2]" + "spike_data[3]" + "spike_data[4]" + "spike_data[5]" + 
    "spike_data[6]" + "spike_data[7]" + "valid"';
}
