    }
    "_so" = '"SCAN_OUT"' {
        ScanOut;
    }
    "_clk" = '"clk" + "rst_n"';
    "all_inputs" = '"SCAN_EN" + "SCAN_IN" + "accumulate_en" + "clk" + 
    "data_in[0]" + "data_in[10]" + "data_in[11]" + "data_in[12]" + "data_in[13]" 
